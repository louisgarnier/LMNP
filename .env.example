# ─────────────────────────────────────────────────────────────
# Enable Banking — connexion bancaire réelle (étape 5 de la refonte)
#
# POUR ACTIVER LA VRAIE BANQUE :
#   1. Copie ce fichier en ".env" (enlève le ".example")
#   2. Remplis ENABLE_BANKING_APP_ID avec ton identifiant d'application
#   3. Dépose ta clé privée dans  secrets/eb_private.pem
#   4. Relance le backend → l'écran Paramètres passe de "Mode démo" à
#      "Connexion Enable Banking active" tout seul.
#
# Ces valeurs ne sont JAMAIS commitées : .env, secrets/ et *.pem
# sont dans .gitignore.
# ─────────────────────────────────────────────────────────────

# 1) Ton identifiant d'application, copié depuis la console Enable Banking
ENABLE_BANKING_APP_ID=

# 2) Chemin vers ta clé privée (laisse tel quel si tu déposes le fichier
#    dans secrets/eb_private.pem comme conseillé)
ENABLE_BANKING_PRIVATE_KEY_PATH=./secrets/eb_private.pem

# 3) URL de redirection — À ENREGISTRER À L'IDENTIQUE dans la console
#    Enable Banking (au caractère près, sans slash en trop).
#
#    ⚠️ Enable Banking en PRODUCTION refuse http://localhost : il faut une
#    adresse HTTPS publique. On utilise un tunnel (ngrok) qui expose ton
#    localhost:3000 en https. Remplace <TON-DOMAINE> par ton domaine ngrok
#    fixe (ex : lmnp-louis.ngrok-free.app). C'est CETTE URL qu'on enregistre
#    chez Enable Banking ET qu'on met ici (les deux doivent être identiques).
#    Le retour de banque rebondit ensuite tout seul vers localhost (garde-fou
#    dans ParametresScreen.tsx → localBounceTarget).
ENABLE_BANKING_REDIRECT_URL=https://<TON-DOMAINE>.ngrok-free.app/dashboard/transactions?tab=parametres&eb_callback=1
